# ================================
# Baraja Coffee Backend Environment
# ================================

# ================================
# DATABASE - MongoDB
# ================================
# Choose ONE of the following:

# Active application connection. Set this on the VPS, never commit credentials.
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Local MongoDB on the VPS:
# MONGO_URI=mongodb://<user>:<password>@127.0.0.1:27017/prod?authSource=admin
MONGO_URI=mongodb://localhost:27017/test

# Legacy variables kept for migration scripts only.
# MONGO=mongodb://localhost:27017/test
# MONGO_PROD=mongodb://localhost:27017/prod

# ================================
# REDIS
# ================================
# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Docker Redis - used automatically in docker-compose
# REDIS_HOST=baraja_redis
# REDIS_URL=redis://baraja_redis:6379

# ================================
# SERVER
# ================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

